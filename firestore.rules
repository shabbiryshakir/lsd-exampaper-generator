rules_version = '2';
// Firestore security rules for Qalam. Publish them in the Firebase console
// (Firestore Database → Rules) or with `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // Admin panel: read-only access to everything. Keep in sync with ADMIN_EMAILS in src/components/AdminPanel.jsx.
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['shabbiryshakir@gmail.com'];
    }

    // Teacher's own settings and templates.
    match /users/{userId} {
      allow read, write: if signedIn() && me() == userId;
      allow read: if isAdmin();
    }

    // Papers: the owner (userId) and members can read and edit; only the owner deletes.
    match /papers/{paperId} {
      function isOwner() { return resource.data.userId == me(); }
      function isMember() { return me() in resource.data.get('members', []); }
      // Joining with an invite code: a teacher may add only themselves, and only with the paper's current code.
      function isJoining() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo', 'joinCode'])
          && resource.data.get('inviteCode', null) != null
          && request.resource.data.joinCode == resource.data.inviteCode
          && request.resource.data.members.hasAll(resource.data.get('members', []))
          && request.resource.data.members.size() == resource.data.get('members', []).size() + 1
          && me() in request.resource.data.members;
      }
      // Leaving: a member may remove only themselves.
      function isLeaving() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberInfo'])
          && !(me() in request.resource.data.members)
          && resource.data.members.removeAll([me()]).hasAll(request.resource.data.members);
      }
      allow read: if signedIn() && (resource == null || isOwner() || isMember() || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == me();
      allow update: if signedIn() && (
        ((isOwner() || isMember()) && request.resource.data.userId == resource.data.userId)
        || isJoining() || isLeaving());
      allow delete: if signedIn() && isOwner();
    }

    // Share codes: anyone signed in who knows the code can open it; nobody can list them.
    match /shares/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == me();
      allow update: if signedIn() && resource.data.ownerId == me() && request.resource.data.ownerId == me();
      allow delete: if signedIn() && resource.data.ownerId == me();
    }

    // Invite codes to work on a paper together.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == me();
      allow delete: if signedIn() && resource.data.ownerId == me();
    }
  }
}
